<Window x:Class="Proje.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern Browser"
        Height="760"
        Width="1280"
        MinHeight="500"
        MinWidth="850"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F172A">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#BF1E293B"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{StaticResource ToolbarButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#00000000"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCommandButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Margin="8" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Özel pencere başlığı -->
            <Border Grid.Row="0" Background="#BF111827" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="  Modern Browser" VerticalAlignment="Center" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowCommandButtonStyle}" Content="─" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource WindowCommandButtonStyle}" Content="❐" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="✕" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Şeffaf araç çubuğu -->
            <Border Grid.Row="1" Margin="10,8,10,8" Background="#BF1E293B" CornerRadius="10" Opacity="0.75">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ToolbarButtonStyle}" Content="←" Click="BackButton_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Content="→" Click="ForwardButton_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Content="⟳" Click="RefreshButton_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Content="⌂" Click="HomeButton_Click"/>

                    <TextBox Grid.Column="4" x:Name="AddressBar" Margin="10,0" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" Padding="10,6" FontSize="14" BorderThickness="0" Background="#E2E8F0"/>

                    <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Content="Git" Click="GoButton_Click"/>
                    <Button Grid.Column="6" Style="{StaticResource ToolbarButtonStyle}" Content="★" ToolTip="Favorilere ekle" Click="AddFavoriteButton_Click"/>
                    <Button Grid.Column="7" Style="{StaticResource ToolbarButtonStyle}" Content="♥" ToolTip="Favoriler" Click="ShowFavoritesButton_Click"/>
                    <Button Grid.Column="8" Style="{StaticResource ToolbarButtonStyle}" Content="🕘" ToolTip="Geçmiş" Click="ShowHistoryButton_Click"/>
                    <Button Grid.Column="9" Style="{StaticResource ToolbarButtonStyle}" Content="◐" ToolTip="Tema değiştir" Click="ToggleThemeButton_Click"/>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="2" x:Name="LoadingBar" Height="3" Margin="10,0,10,0" IsIndeterminate="True" Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button Content="+ Yeni Sekme" Style="{StaticResource AccentButtonStyle}" Width="110" Margin="0,0,8,0" Click="AddTabButton_Click"/>
                    <TabControl x:Name="TabsHeader" SelectionChanged="TabsHeader_SelectionChanged" Background="Transparent" BorderThickness="0"/>
                </DockPanel>

                <Grid Grid.Row="1" x:Name="BrowserHost" Background="#020617"/>
            </Grid>
        </Grid>
    </Border>
</Window>
